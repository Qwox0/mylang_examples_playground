    send :: (self: *mut Self, mut val: T) -> {
        if std.atomic.load(self.*.chan.*.is_closed.&mut, .Relaxed)  std.panic("send on closed channel");

        loop {
            receiver_slot := std.atomic.cmpxchg_strong(self.*.chan.*.transfer_slot.&mut, null, &mut val, .Relaxed, .Relaxed);
            switch receiver_slot {
                null :> {
                    // no receiver yet. we wait.
                    std.assert(self.*.chan.*.send_futex == FUTEX_NO_WAIT, "send_futex == FUTEX_NO_WAIT");
                    self.*.chan.*.send_futex = FUTEX_WAITING;

