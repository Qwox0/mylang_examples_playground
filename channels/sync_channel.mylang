                    if DEBUG  libc.printf("receive futex_wake res = %d; slot = %p\n".ptr, res, self.*.chan.*.transfer_slot);
                    res |> libc.result().unwrap();
                };
            }
            break;
        }

        Some(ret)
    }
}
