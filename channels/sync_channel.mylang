/*
ChannelData :: struct($T) {
    transfer_slot: ?*mut T = null,
    is_closed: bool = false,
    send_futex: u32 = CHAN_WAITING,
    recv_futex: u32 = CHAN_WAITING,
}

ChannelFutexState :: enum {
    Waiting,
}


CHAN_WAITING   : u32 : 0;
CHAN_OPERATING : u32 : 1;
CHAN_CLOSING   : u32 : 2;
CHAN_CLOSED    : u32 : 3;

SendResult :: enum {
    Ok,
    Closed,

    unwrap :: (self: SendResult) -> switch self {
        .Ok :> {},
        .Closed :> std.panic("send on closed channel"),
    };
}

Sender :: struct($T) {
    chan: *mut ChannelData(T);

    Self :: Sender(T);

    send :: (self: *mut Self, mut val: T) -> SendResult {
        if std.atomic.load(self.*.chan.*.send_futex.&mut, .Relaxed) == CHAN_CLOSED return .Closed;

        loop {
            //std.assert(self.*.chan.*.send_futex == CHAN_WAITING, "send_futex == CHAN_WAITING");
            receiver_slot := std.atomic.cmpxchg_strong(self.*.chan.*.transfer_slot.&mut, null, &mut val, .Relaxed, .Relaxed);
            switch receiver_slot {
                null :> {
                    if DEBUG libc.printf("Sender waiting: send_futex = %d; recv_futex = %d\n".ptr, self.*.chan.*.send_futex, self.*.chan.*.recv_futex);
                    blocking := std.atomic.cmpxchg_strong(self.*.chan.*.send_futex.&mut, CHAN_WAITING, CHAN_OPERATING, .Relaxed, .Relaxed) == null;
                    if blocking  std.assert(self.*.chan.*.recv_futex != CHAN_OPERATING, "deadlock (Sender)");
                    res := futex.futex_wait(self.*.chan.*.send_futex.&mut, CHAN_OPERATING, null);
                    if DEBUG  libc.printf("send futex_wait res = %d; slot = %p\n".ptr, res, self.*.chan.*.transfer_slot);
                    //res |> libc.result().unwrap();
                };
                Some :> {
                    // receiver is waiting
                    receiver_slot := std.atomic.rmw(self.*.chan.*.transfer_slot.&mut, null, .Xchg, .Acquire) // acquires `recv_futex`
                        orelse continue; // transfer_slot changed between cmpxchg and xchg

                    receiver_slot.* = val;
                    if DEBUG  libc.printf("send wrote to slot: %d\n".ptr, val);

                    std.assert(self.*.chan.*.recv_futex == CHAN_OPERATING, "recv_futex == CHAN_OPERATING");
                    //self.*.chan.*.recv_futex = CHAN_OPERATING;
                    res := futex.futex_wake(self.*.chan.*.recv_futex.&mut, 1);
                    if DEBUG  libc.printf("send futex_wake res = %d; slot = %p\n".ptr, res, self.*.chan.*.transfer_slot);
                    res |> libc.result().unwrap();
                };
            }
            break;
        }
        ;.Ok
    }

    close :: (self: *mut Self) -> {
        std.atomic.store(self.*.chan.*.is_closed.&mut, true, .Relaxed);
        if DEBUG  libc.printf("close recv_futex = %d\n".ptr, self.*.chan.*.recv_futex);

        // inactive -> closed
        // waiting -> closing

        if std.atomic.cmpxchg_strong(self.*.chan.*.recv_futex.&mut, CHAN_WAITING, CHAN_CLOSED, .Relaxed, .Relaxed) == null {
            res := futex.futex_wake(self.*.chan.*.recv_futex.&mut, std.num.u32_MAX);
            if DEBUG  libc.printf("close futex_wake res = %d\n".ptr, res);
        }
        /*
        else if std.atomic.cmpxchg_strong(self.*.chan.*.recv_futex.&mut, CHAN_OPERATING, CHAN_CLOSED, .Relaxed, .Relaxed) == null {
            res := futex.futex_wake(self.*.chan.*.recv_futex.&mut, std.num.u32_MAX);
            if DEBUG  libc.printf("close futex_wake res = %d\n".ptr, res);
        }
        */
    }
}
Receiver :: struct($T) {
    chan: *mut ChannelData(T);

    Self :: Receiver(T);

    receive :: (self: *mut Self) -> ?T {
        if std.atomic.load(self.*.chan.*.is_closed.&mut, .Relaxed) return null; // closed

        mut ret: T;

        loop {
            //std.assert(self.*.chan.*.recv_futex == CHAN_WAITING, "recv_futex == CHAN_WAITING");
            sender_slot := std.atomic.cmpxchg_strong(self.*.chan.*.transfer_slot.&mut, null, &mut ret, .Relaxed, .Relaxed);
            switch sender_slot {
                null :> {
                    // no sender yet. we wait.
                    if DEBUG libc.printf("Receiver waiting: send_futex = %d; recv_futex = %d\n".ptr, self.*.chan.*.send_futex, self.*.chan.*.recv_futex);
                    blocking := std.atomic.cmpxchg_strong(self.*.chan.*.recv_futex.&mut, CHAN_WAITING, CHAN_OPERATING, .Relaxed, .Relaxed) == null;
                    if blocking  std.assert(self.*.chan.*.send_futex != CHAN_OPERATING, "deadlock (Receiver)");
                    res := futex.futex_wait(self.*.chan.*.recv_futex.&mut, CHAN_OPERATING, null);
