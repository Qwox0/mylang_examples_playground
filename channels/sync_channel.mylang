                            orelse continue; // transfer_slot changed between cmpxchg and xchg

                    ret = sender_slot.*;
                    if DEBUG  libc.printf("receive read from slot: %d\n".ptr, ret);

                    std.assert(self.*.chan.*.send_futex == CHAN_OPERATING, "send_futex == CHAN_OPERATING");
