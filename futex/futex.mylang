ThreadCreateResult :: libc.Result;
spawn_with_capture :: (func: *mut $C -> void, capture: *mut C, attr: ?*libc.pthread_attr_t = null) -> ThreadCreateResult {
    mut thread_id: libc.pthread_t;
    res := libc.pthread_create(&mut thread_id, attr, xx &func, capture) |> libc.thread_result();
    switch res { .Ok :> .Ok(thread_id) } else res
}

// memory ordering (atomics)
// <https://www.youtube.com/watch?v=ZQFzMfHIxng>
// <https://www.youtube.com/watch?v=rMGWeSjctlY>
//
// non-atomic:     memory operations might never be visible (to/from other threads)
// atomic relaxed: memory operations on the atomic value are visible (to/from other threads)
//                 memory operations on other values might not be visible (due to reordering)


