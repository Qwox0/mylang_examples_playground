std :: #import "std";
libc :: #import "libc";

linux_sys :: #import "../../mylang_c_bindings/generated/linux/sys/syscall.h.mylang";
linux_futex :: #import "../../mylang_c_bindings/generated/linux/linux/futex.h.mylang";

FUTEX_FLAGS :: struct {
    PRIVATE :: linux_futex.FUTEX_PRIVATE_FLAG;
    CLOCK_REALTIME :: linux_futex.FUTEX_CLOCK_REALTIME;
}

// TODO: use this
futex_param4 :: union {
    timeout: ?*libc.timespec,
    val2: u32,
};

futex_syscall :: (uaddr: *u32, futex_op: libc.c_int, val: u32, val2OrTimeout: usize, uaddr2: ?*mut u32, val3: u32) ->
    libc.syscall(linux_sys.SYS_futex, uaddr, futex_op, val, val2OrTimeout, uaddr2, val3);

futex_wait :: (uaddr: *u32, /*futex_op: libc.c_int,*/ val: u32, timeout: ?*libc.timespec, val3: u32 = linux_futex.FUTEX_BITSET_MATCH_ANY) ->
    futex_syscall(uaddr, linux_futex.FUTEX_WAIT_BITSET, val, xx timeout, null, val3);

futex_wake :: (uaddr: *u32, /*futex_op: libc.c_int,*/ wake_count: u32, val3: u32 = linux_futex.FUTEX_BITSET_MATCH_ANY) ->
    futex_syscall(uaddr, linux_futex.FUTEX_WAKE_BITSET, wake_count, 0, null, val3);

futex_requeue :: (uaddr: *u32, /*futex_op: libc.c_int,*/ val: u32, val2: u32, uaddr2: ?*mut u32, cmpval: ?u32 = null) -> {
    switch cmpval {
        Some :> futex_syscall(uaddr, linux_futex.FUTEX_CMP_REQUEUE, val, xx val2, uaddr2, cmpval);
        null :> futex_syscall(uaddr, linux_futex.FUTEX_REQUEUE, val, xx val2, uaddr2, 0);
    }
}

futex_wake_op :: (uaddr: *mut u32, /*futex_op: libc.c_int,*/ val: u32, val2: u32, uaddr2: ?*mut u32, val3: u32) ->
    futex_syscall(uaddr, linux_futex.FUTEX_WAKE_OP, val, xx val2, uaddr2, val3);

futex_waitv :: void; // TODO

