// @BENCH: add CONTENDED state
// @BENCH: only loads during spin
Mutex :: struct {
    is_locked: u32 = UNLOCKED; // bool32

    LOCKED :: true.as(u32);
    UNLOCKED :: false.as(u32);

    try_lock :: (self: *mut Mutex) -> {
        res := std.atomic.cmpxchg_strong(self.*.is_locked.&mut, UNLOCKED, LOCKED, .Acquire, .Relaxed);
        if res == null  Lock.{ mutex=self } else null
    }

    try_lock_weak :: (self: *mut Mutex) -> {
        res := std.atomic.cmpxchg_weak(self.*.is_locked.&mut, UNLOCKED, LOCKED, .Acquire, .Relaxed);
        if res == null  Lock.{ mutex=self } else null
    }

    try_lock_spinning :: (self: *mut Mutex, mut spins := 100) -> {
        while spins > 0 {
            lock := self.try_lock_weak();
            switch lock { Some :> return lock } else {}
            spins -= 1;
        }
        return null;
    }

    lock_blocking :: (self: *mut Mutex) -> {
        loop {
            basic_lock := self.try_lock_spinning() orelse {
                futex_wait(self.*.is_locked.&mut, LOCKED, null) |> libc.result().unwrap();
                continue;
            };
            return FutexLock.{ basic_lock };
        }
    }

    Lock :: struct {
        mutex: *mut Mutex;
        unlock :: (self: Lock) -> std.atomic.store(self.mutex.*.is_locked.&mut, UNLOCKED, .Release);
    };

    FutexLock :: struct {
        basic_lock: Lock;
        unlock :: (self: FutexLock) -> {
            self.basic_lock.unlock();
            futex_wake(self.basic_lock.mutex.*.is_locked.&mut, 1) |> libc.result().unwrap();
        }
    };
}


main :: -> {
    std.println("\n========== BASIC FUTEX ==========");
    {
        mut futex_val: u32 = 0;

        libc.printf("[main] futex_val = %d\n".ptr, futex_val);

        // thread 1
        t1 := spawn_with_capture((futex: *mut u32) -> {
            std.println("[1] start");
            for i in 1.as(u32)..5 {
                libc.printf("[1] i = %d\n".ptr, i);
                libc.sleep(1);
            }

            res := futex_wake(futex, 1000) |> libc.result().unwrap();
            libc.printf("[1] futex_wake res = %d\n".ptr, res);

            std.println("[1] exit");
        }, &mut futex_val).unwrap();

        // thread 2
        t2 := spawn_with_capture((futex: *mut u32) -> {
            libc.printf("[2] futex_val = %d\n".ptr, futex.*);
            std.println("[2] wait on futex");
            res := futex_wait(futex, 0, null) |> libc.result().unwrap();
            libc.printf("[2] futex_wait res = %d\n".ptr, res);

            std.println("[2] exit");
        }, &mut futex_val).unwrap();

        // join
        libc.pthread_join(t1, null) |> libc.thread_result().unwrap();
        std.println("[main] thread 1 joined");
        libc.pthread_join(t2, null) |> libc.thread_result().unwrap();
        std.println("[main] thread 2 joined");

        res := futex_wake(&mut futex_val, 1);
        libc.printf("res = %d\n".ptr, res);
    }

