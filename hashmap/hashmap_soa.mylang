std :: #import "std";
libc :: #import "libc";
//HashMap :: std.HashMap;
Allocator :: std.mem.Allocator;

DEBUG :: false;

Hash :: u32;

default_hash :: (key: []u8) -> std.hash.rapidhash_v3(key).as(Hash);

/*
KeyImpl :: interface($K) {
    hash: (key: K) -> Hash;
    eq: (lhs: K, rhs: K) -> bool;
}
*/

DefaultKeyImpl :: struct($K) {
    hash :: (key: K) -> default_hash(std.mem.as_bytes(&key));
    eq :: (lhs: K, rhs: K) -> lhs == rhs;
}

// TODO: remove $K generic
StringKeyImpl :: struct($K) {
    hash :: default_hash;
    eq :: std.str.eq;
}

//StringHashMap :: ($V, $Impl := StringKeyImpl) -> HashMap([]u8, V, Impl);

HashMap :: struct($K, $V, $Impl := DefaultKeyImpl) {
    raw: Raw,

    Self :: HashMap(K, V, Impl);
    Raw :: RawHashMap(K, V);
    Entry :: Raw.Entry;

    hash :: Impl(K).hash;
    eq :: Impl(K).eq;
    key_eq :: (capture: K) -> std.closures.EqClosure(K, K).{ fn = &eq, capture };

    pub EMPTY :: Self.(.EMPTY);

    pub new :: (capacity: u32 = MIN_CAPACITY, alloc: Allocator) -> Self.(.new(capacity, alloc));
    pub destroy :: (self: Self, alloc: Allocator) -> self.raw.destroy(alloc);

    pub size :: (self: *Self) -> self.*.raw.size;

    /// The number of elements in the set for which no allocations are guaranteed.
    pub capacity :: (self: *Self) -> self.*.raw.&.capacity();

    pub get :: (self: *Self, key: K) -> ?V {
        self.*.raw.&.get(key, &hash, &eq)
    }

    pub get_entry :: (self: *Self, key: K) -> ?Entry {
        self.*.raw.&.get_entry(key, &hash, &eq)
    }

    pub contains_key :: (self: *Self, key: K) -> bool {
        if self.*.raw.&.is_empty() return false; // TODO: unlikely branch
        hash := hash(key);
        self.*.raw.&.find(hash, key_eq(key)) orelse return false;
        true
    }

    pub reserve :: (self: *mut Self, additional: u32, alloc: Allocator) -> {
        self.*.raw.&mut.reserve(additional, &hash, alloc)
    }

    pub insert :: (self: *mut Self, key: K, val: V, alloc: Allocator) -> ?V {
        self.*.raw.&mut.insert(key, val, &hash, &eq, alloc)
    }

    pub insert_assume_capacity :: (self: *mut Self, key: K, val: V) -> ?V {
        self.*.raw.&mut.insert_assume_capacity(key, val, &hash, &eq)
    }

    pub remove :: (self: *mut Self, key: K) -> ?Entry {
        self.*.raw.&mut.remove(key, &hash, &eq)
    }

    pub reset :: (self: *mut Self) -> self.*.raw.&mut.reset();

    /*
    pub reset_with_free :: (self: *mut Self, alloc: Allocator) -> {
        for idx in 0..self.*.table.&.slots()
            alloc.free(self.*.table.&.entry(idx, ENTRY_LAYOUT.size));
        self.reset();
    }

    /*
    pub debug :: (self: *Self) -> {
        self.*.table.&.debug(
            ENTRY_LAYOUT.size,
            & v -> {
                entry := v.as(*Entry).*;
                std.fmt.format("key=\"%.*s\"; val=%p", xx entry.key.len, xx entry.key.ptr, xx entry.val)
            },
            & text -> libc.free(text.ptr),
        );
    }
    */
    */
}

Layout :: std.mem.Layout;
max :: std.num.max_u32;
EqClosure :: std.closures.EqClosure;

Size :: u32;
MAX_LOAD_PERCENTAGE :: 85;
MIN_CAPACITY :: 8;

RawHashMap :: struct($K, $V) {
    /// points to `[V * slots, _, K * slots, Tag * slots]`
    ///                                      ^ ptr
    ptr: ?*mut Tag,
    /// The number of elements in the set.
    size: Size,
    /// The number of elements which can be inserted before `MAX_LOAD_PERCENTAGE` is exceeded.
    available: Size,
    /// The mask used to access elements in the buffer. One less than the number of allocated slots.
    mask: Size,

    Self :: RawHashMap(K, V);

    Entry :: struct { key: K, val: V }
    EntryRef :: struct {
        key: *mut K,
        val: *mut V,

        deref :: (self: EntryRef) -> Entry.{ key=self.key.*, val=self.val.* };
    }
    //ENTRY_LAYOUT :: std.mem.Layout.{ size = #sizeof(Entry), align = #alignof(Entry) };

    /// stores 1 bit to indicate whether a value is present and if present the 7 upper bits of the
    /// hash.
    Tag :: struct {
        val: u8,

        //#assert(#sizeof(Tag) == 1);

        empty :: Tag.(0);
        deleted :: Tag.(1);
        //#assert(!empty.is_used());
        //#assert(!deleted.is_used());

        IS_USED_MASK : u8 : 0b1000_0000;

        is_used :: (tag: Tag) -> (tag.val & IS_USED_MASK) != 0;

        from_hash :: (hash: Hash) -> Tag.((hash >> 8 * #sizeof(Hash) - 7).as(u8) | IS_USED_MASK);

        eq :: (self: Tag, other: Tag) -> self.val == other.val;
    };

    pub EMPTY :: Self.{ ptr=null, size=0, available=0, mask=!0 };

    pub new :: (capacity: Size, alloc: Allocator) -> Self.allocate(capacity_to_slots(capacity), alloc);

    pub destroy :: (self: Self, alloc: Allocator) -> {
        if self.ptr != null then alloc.free(self.&.buf_start());
    }

    // ========== memory stuff ==========
    // TODO?: swap order of keys (`..., _, KN ... K2, K1, K0, Tag0, Tag1, ...`)
    /*                  v BUF_ALIGN :: std.num.max(#alignof(V), #alignof(K)) */
    /*                             v */ PADDING_BETWEEN_VALUES_AND_KEYS :: #alignof(K);
    /*                                           v */ // #assert(alignof(Tag) == 1, "no padding needed");
    // buffer layout: `[V * slots, _, K * slots, Tag * slots]`
    //                                           ^ ptr
    //                                ^ ptr - sizeof(K) * slots
    //                  ^ ptr - (sizeof(K) + sizeof(V)) * slots - padding


    // TODO: const
    BUF_ALIGN :: -> usize  if #sizeof(V) == 0 then #alignof(K) else #alignof(V);
    PADDING :: -> usize  if #sizeof(V) == 0 then 0 else
        #alignof(K) |> std.num.saturating_sub(#alignof(V), Int=usize);

    allocate :: (slots: Size, alloc: Allocator) -> Self
        try_allocate(slots, alloc) orelse std.panic("HashMap allocation failed!");

    try_allocate :: (slots: Size, alloc: Allocator) -> ?Self {
        if DEBUG std.assert(std.num.is_power_of_2(slots.as(u64)));

        buf_ptr := alloc.alloc(buf_size(slots), BUF_ALIGN()) orelse return null;

        ptr := buf_ptr |> std.ptr.add_bytes(ptr_offset(slots)).as(*mut Tag);
        init_tags(ptr, slots);

        available := slots_to_available(slots);
        self := Self.{ ptr, size = 0, available, mask = slots - 1 };

        if DEBUG  std.assert(self.&.values().ptr |> std.ptr.is_aligned(#alignof(V)));
        if DEBUG  std.assert(self.&.keys().ptr |> std.ptr.is_aligned(#alignof(K)));

        Some(self)
    }

    init_tags :: (tags_ptr: ?*mut Tag, slots: Size) -> {
        ptr := tags_ptr orelse {
            if DEBUG std.assert(slots == 0);
            return;
        };
        if DEBUG std.assert(slots > 0);
        libc.memset(ptr, 0, slots.as(u64));
    };

    ptr_offset :: (slots: Size) -> (#sizeof(V) + #sizeof(K)) * slots.as(usize) + PADDING();

    buf_start :: (self: *Self) -> {
        ptr := self.*.ptr orelse return null;
        ptr.as(*mut u8) |> std.ptr.sub_bytes(ptr_offset(self.slots()))
    }

    buf_size :: (slots: Size) -> {
        if DEBUG std.assert(slots == 0 or std.num.is_power_of_2(slots));
        if DEBUG std.assert(#alignof(Tag) == 1, "no padding needed"); // TODO: `#assert`
        (#sizeof(V) + #sizeof(K) + #sizeof(Tag)) * slots.as(usize) + PADDING()
    }

    keys :: (self: *Self) -> []mut K {
        ptr := self.*.ptr orelse return .[][..]mut;
        slots := self.slots().as(usize);
        keys_ptr := ptr |> std.ptr.sub_bytes(#sizeof(K) * slots).as(*mut K);
        if DEBUG  std.assert(keys_ptr |> std.ptr.is_aligned(#alignof(K)));
        []mut K.{ ptr=keys_ptr, len=slots }
    }

    values :: (self: *Self) -> []mut V {
        ptr := self.*.ptr orelse return .[][..]mut;
        slots := self.slots().as(usize);
        values_ptr := ptr |> std.ptr.sub_bytes((#sizeof(K) + #sizeof(V)) * slots + PADDING()).as(*mut V);
        if DEBUG  std.assert(values_ptr |> std.ptr.is_aligned(#alignof(V)));
        []mut V.{ ptr=values_ptr, len=slots }
    }

    pub tag :: (self: *Self, idx: Size) -> *mut Tag {
        if DEBUG std.assert(idx < self.slots());
        if DEBUG std.assert(not self.is_empty());
        ptr := self.*.ptr orelse std.panic("unreachable");
        ptr |> std.ptr.add_bytes(idx.as(usize))
    };

    pub entry :: (self: *Self, idx: Size) -> EntryRef {
        if DEBUG std.assert(idx < self.slots());
        EntryRef.{
            key=&mut self.keys()[idx],
            val=&mut self.values()[idx],
        }
    }

    // ========== infos ==========

    /// The number of elements the set can hold without reallocating.
    pub capacity :: (self: *Self) -> self.*.size + self.*.available;

    /// The number of allocated slots.
    /// `capacity * 100 / slots <= MAX_LOAD_PERCENTAGE`
    pub slots :: (self: *Self) -> self.*.mask + 1;

    is_empty :: (self: *Self) -> self.*.mask == EMPTY.mask;

    // ========== search ==========

    pub find :: (self: *Self, hash: Hash, eq: EqClosure(K, $Capture)) -> ?Size {
        if self.is_empty() return null; // TODO: unlikely branch
        tag := Tag.from_hash(hash);

        mask := self.*.mask;
        mut idx := hash & mask;

        loop {
            slot_tag := self.tag(idx).*;
            if slot_tag.eq(tag) and eq.call(self.keys()[idx]) return Some(idx);
            if slot_tag.eq(Tag.empty) return null;

            idx = (idx + 1) & mask;
        }
    }

    pub find_or_insert_slot_assume_capacity :: (self: *Self, hash: Hash, eq: EqClosure(K, $Capture)) -> Size {
        if DEBUG std.assert(!self.is_empty());
        if DEBUG std.assert(self.*.available > 0);
        tag := Tag.from_hash(hash);

        mask := self.*.mask;
        mut idx := hash & mask;

        mut deleted_tag_idx: ?Size = null;

        loop {
            slot_tag := self.tag(idx).*;
            if slot_tag.eq(tag) and eq.call(self.keys()[idx]) return idx
            else if slot_tag.eq(Tag.deleted) then deleted_tag_idx = Some(idx)
            else if slot_tag.eq(Tag.empty) break;

            idx = (idx + 1) & mask;
        }

        deleted_tag_idx orelse idx
    }

    /// assumes val is not in the set.
    /// assumes that no deleted items are in the set
    find_realloc_slot :: (self: *Self, hash: Hash) -> Size {
        if DEBUG std.assert(!self.is_empty());
        if DEBUG std.assert(self.*.available > 0);

        mask := self.*.mask;
        mut idx := hash & mask;

        while not self.tag(idx).*.eq(Tag.empty) {
            idx = (idx + 1) & mask;
        }

        idx
    }

    pub get :: (self: *Self, key: K, hasher: *(key: K) -> Hash, key_eq: *(k1: K, k2: K) -> bool) -> ?V {
        Some((self.get_entry(key, hasher, key_eq) orelse return null).val)
    }

    pub get_entry :: (
        self: *Self,
        key: K,
        hasher: *(key: K) -> Hash,
        key_eq: *(k1: K, k2: K) -> bool,
    ) -> ?Entry {
        if self.is_empty() return null; // TODO: unlikely branch
        hash := hasher.*(key);
        idx := self.find(hash, EqClosure(K, K).{ fn=key_eq, capture=key }) orelse return null;
        Some(self.entry(idx).deref())
    }

    /*
    pub contains_key :: (self: *Self, key: K) -> bool {
        if self.is_empty() return false; // TODO: unlikely branch
        hash := hash(key);
        self.*.table.&.find(hash, key_eq(&key), ENTRY_LAYOUT.size) orelse return false;
        true
    }
    */

    // ========== insert ==========

    pub reserve :: (
        self: *mut Self,
        additional: Size,
        hasher: *(key: K) -> Hash,
        alloc: Allocator,
    ) -> {
        if (self.*.available >= additional) return;

        // TODO: overflow check for `+`
        new_capacity := std.num.ceil_pow_of_2_u32(self.*.size + additional).max(MIN_CAPACITY);
        mut new_table := Self.new(new_capacity, alloc);

        for idx in 0..self.slots() {
            if not self.tag(idx).*.is_used() continue;
            entry := self.entry(idx);
            hash := hasher.*(entry.key.*);

            new_idx := new_table.&.find_realloc_slot(hash);
            new_table.&mut.tag(new_idx).* = Tag.from_hash(hash);

            new_entry := new_table.&mut.entry(new_idx);

            libc.memcpy(new_entry.key, entry.key, #sizeof(K));
            libc.memcpy(new_entry.val, entry.val, #sizeof(V));
        }

        if DEBUG std.assert(new_table.available >= self.*.size);
        new_table.available -= self.*.size;
        new_table.size = self.*.size;

        self.*.destroy(alloc);
        self.* = new_table;
    }

    pub insert :: (
        self: *mut Self,
        key: K,
        val: V,
        hasher: *(key: K) -> Hash,
        key_eq: *(k1: K, k2: K) -> bool,
        alloc: Allocator,
    ) -> ?V {
        self.reserve(1, hasher, alloc);
        self.insert_assume_capacity(key, val, hasher, key_eq)
    }

    pub insert_assume_capacity :: (
        self: *mut Self,
        key: K,
        val: V,
        hasher: *(key: K) -> Hash,
        key_eq: *(k1: K, k2: K) -> bool,
    ) -> ?V {
        hash := hasher.*(key);
        eq := EqClosure(K, K).{ fn=key_eq, capture=key };
        slot := self.insert_slot_assume_capacity(hash, eq);
        entry := slot.entry;
        if slot.occupied {
            old_val := entry.val.*;
            entry.val.* = val;
            Some(old_val)
        } else {
            entry.key.* = key;
            entry.val.* = val;
            null
        }
    }

    InsertSlot :: struct {
        entry: EntryRef,
        occupied: bool,
    }

    pub insert_slot_assume_capacity :: (self: *mut Self, hash: Hash, eq: EqClosure(K, $Capture)) -> {
        idx := self.find_or_insert_slot_assume_capacity(hash, eq);
        self.insert_slot_at(idx, hash)
    }

    pub insert_slot_at :: (self: *mut Self, idx: Size, hash: Hash) -> InsertSlot {
        occupied := self.tag(idx).*.is_used();
        entry := if occupied {
            if DEBUG std.assert(self.tag(idx).*.eq(Tag.from_hash(hash)));
            self.entry(idx)
        } else {
            self.insert_slot_at_assume_empty(idx, hash)
        };
        .{ entry, occupied }
    }

    // inline?
    pub insert_slot_at_assume_empty :: (self: *mut Self, idx: Size, hash: Hash) -> EntryRef {
        if DEBUG std.assert(self.*.available > 0);
        if DEBUG std.assert(not self.tag(idx).*.is_used());

        self.tag(idx).* = Tag.from_hash(hash);
        self.*.size += 1;
        self.*.available -= 1;
        self.entry(idx)
    }

    // ========== remove ==========

    pub remove :: (
        self: *mut Self,
        key: K,
        hasher: *(key: K) -> Hash,
        key_eq: *(k1: K, k2: K) -> bool,
    ) -> ?Entry {
        self.remove_raw(hasher.*(key), EqClosure(K, K).{ fn=key_eq, capture=key })
    }

    pub remove_raw :: (self: *mut Self, hash: Hash, eq: EqClosure(K, $Capture)) -> ?Entry {
        idx := self.find(hash, eq) orelse return null;
        Some(self.remove_at(idx))
    }

    pub remove_at :: (self: *mut Self, idx: Size) -> Entry {
        if DEBUG std.assert(self.tag(idx).*.is_used());

        self.tag(idx).* = Tag.deleted;
        self.*.size -= 1;
        self.*.available += 1;
        self.entry(idx).deref() // @Bench: Is dereferencing both a problem?
    }

    pub reset :: (self: *mut Self) -> {
        init_tags(self.*.ptr, self.slots());
        self.*.available += self.*.size;
        self.*.size = 0;
    }

    pub debug :: (
        self: *Self,
        format_entry: *(entry: EntryRef) -> []u8,
        free_text: ?*(text: []u8) -> void = null,
        c_stream := libc.stderr,
    ) -> {
        libc.fprintf(c_stream, "HashMap (ptr=%p; size=%d; available=%d; mask=0x%08x) {\n".ptr, self.*.ptr, self.*.size, self.*.available, self.*.mask);
        for idx in 0..self.slots() {
            tag := self.tag(idx).*;
            text := if tag.is_used() then format_entry.*(self.entry(idx))
            else if tag.eq(Tag.empty) then "EMPTY"
            else "DELETED";

            libc.fprintf(c_stream, "  %.*s (%08b),\n".ptr, text.len, text.ptr, tag.val);

            if tag.is_used() {
                free_text := free_text orelse continue;
                free_text.*(text);
            }
        }
        libc.fprintf(c_stream, "}\n".ptr);
    }
}

/// Returns the number of slots needed to allow inserting `capacity` items without reallocating.
capacity_to_slots :: (capacity: u32) -> {
    unaligned_slots := capacity.as(u64) * 100 / MAX_LOAD_PERCENTAGE + 1;
    slots := std.num.ceil_pow_of_2_u64(unaligned_slots);
    if DEBUG  std.assert(slots <= std.num.u32_MAX.as(u64), "capacity_to_slots overflow");
    slots.as(u32)
}

slots_to_available :: (slots: u32) -> (slots.as(u64) * MAX_LOAD_PERCENTAGE / 100).as(u32);

test_map :: -> {
    fail :: () -> std.panic("test failed");

    alloc := std.ctx.alloc;

    mut map := HashMap([]u8, *any, StringKeyImpl).new(alloc=alloc);
    defer map.destroy(alloc);
    map := &mut map;

    std.assert(map.size() == 0);

    std.println("insert");
    map.insert("key 1", "some value".ptr, alloc);
    v2 := "another value".ptr;
    map.insert("abc", v2, alloc);
    map.insert("3", "third value".ptr, alloc);
    std.assert(map.size() == 3);
    std.assert((map.get("abc") orelse fail()) == v2);

    std.println("insert duplicate keys");
    key1 := "my key";
    key2 := std.str.strdup(key1) orelse fail();
    defer std.ctx.alloc.free(key2.ptr);
    std.assert(key1.ptr != key2.ptr);

    map.insert(key1, key1.ptr, alloc);
    std.assert(map.size() == 4);
    std.assert((map.get(key1) orelse fail()) == key1.ptr);
    std.assert((map.get(key2) orelse fail()) == key1.ptr);

    map.insert(key2, key2.ptr, alloc);
    std.assert(map.size() == 4);
    std.assert((map.get(key1) orelse fail()) == key2.ptr);
    std.assert((map.get(key2) orelse fail()) == key2.ptr);


    std.println("not contains");
    std.assert(not map.contains_key("not in map"));

    /*
    std.println("automatic resizing");
    libc.printf("cap: %d / slots: %d\n".ptr, map.capacity(), map.*.table.&.slots());
    for idx in 0..70 {
        str := std.fmt.format("additional item %d", xx idx); // leaked
        libc.printf("## insert additional item: %s\n".ptr, str.ptr);
        map.insert(str, str.ptr, alloc);
        libc.printf("cap: %d / slots: %d\n".ptr, map.capacity(), map.*.table.&.slots());
    }

    map.debug();
    */
}


    // V: size=0; align=1
    // K: size=8; align=8
    //
    // buf_align := max(1, 8) = 8
    // values_start := 0
    // values_end := values_start + #sizeof(V) * slots = 0
    // padding := 0;
    // keys_start := 0;
    // keys_end := #sizeof(K) * slots;
    // ptr := buf_ptr + keys_end;
    // ------
    // keys_start := ptr - #sizeof(K) * slots
    // values_start := keys_start - padding - #sizeof(V) * slots
    //              := keys_start - 0       - 0


    // #assert(#sizeof(K) == 0 or std.num.is_multiple_of(#sizeof(K), #alignof(K)));
    // #assert(#sizeof(V) == 0 or std.num.is_multiple_of(#sizeof(V), #alignof(V)));
    // sv := #sizeof(V);
    // sk := #sizeof(K);
    // av := #alignof(V);
    // ak := #alignof(K);
    //
    // For sv > 0
    //              sv % av == 0
    //   => slots * sv % av == 0
    //
    // align_of (buf)       = #alignof(V)
    // align_of (V * slots) = #alignof(#sizeof(V) * slots)

    // V: size=10; align=2
    // K: size=1; align=4
    //
    // buf_align := max(2, 4) = 4
    // values_start := 0
    // values_end := values_start + #sizeof(V) * slots = 0 + 10 * slots
    //
    // 1010
    //
    //  100
    //
    //
    // padding := 0;
    // keys_start := 0;
    // keys_end := #sizeof(K) * slots;
    // ptr := buf_ptr + keys_end;
    // ------
    // keys_start := ptr - #sizeof(K) * slots
    // values_start := keys_start - padding - #sizeof(V) * slots
    //              := keys_start - 0       - 0

    // V: size=10; align=2
    // K: size=0; align=1


    /*
padding = (align - (offset mod align)) mod align
aligned = offset + padding
        = offset + ((align - (offset mod align)) mod align)

padding = (align - (offset & (align - 1))) & (align - 1)
        = -offset & (align - 1)
aligned = (offset + (align - 1)) & ~(align - 1)
        = (offset + (align - 1)) & -align
     */

    // special case: no padding needed
    // #alignof(K), #alignof(V), slots are all powers of 2
    //
    // #assert(#sizeof(K) >= #alignof(K) and std.num.is_multiple_of(#sizeof(K), #alignof(K)));
    // #assert(#sizeof(V) >= #alignof(V) and std.num.is_multiple_of(#sizeof(V), #alignof(V)));

