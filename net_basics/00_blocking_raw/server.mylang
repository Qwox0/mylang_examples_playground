std :: #import "std";
libc :: #import "libc";

// (-) only one connection at a time
// (-) no signal handling

main :: -> {
    socket := std.net.RawSocket.new(.INET, libc.SOCK_STREAM, 0);
    defer {
        std.println("Closing socket ...");
        socket.close();
    };

    socket.set_reuse_address();

    ADDR :: "0.0.0.0";
    PORT :: 12345;
    libc.printf("Listening on %s:%d\n".ptr, ADDR.ptr, PORT);
    socket.bind(.parse(ADDR), PORT);

    socket.listen();

    while true {
        std.println("Waiting for new connection ...");
        conn := socket.accept().socket;
        defer {
            libc.printf("Closing connection %d ...\n".ptr, conn.fd);
            conn.close();
        };

        libc.printf("New connection: %d\n".ptr, conn.fd);

        conn.send("Hello from the server\n");

        mut buf: [10 * 1024]u8;
        while true {
            msg := conn.receive(buf[..]mut) orelse break;
            libc.printf("received %zd bytes from connection %d: '%.*s'\n".ptr, msg.len, conn.fd, msg.len, msg.ptr);

            libc.sleep(1);

            sent_len := conn.send(msg);
            libc.printf("wrote %zd bytes\n".ptr, sent_len);
        }
    }

    return 0;
}

